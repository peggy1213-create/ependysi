# Copy to backend/.env and fill in. Never commit the real .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# --- News tab: AI analysis (Gemini) ---
# Needed only for the "Analyze with AI" button on the News tab. News fetching
# itself needs no key. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model. Default: gemini-3.6-flash
GEMINI_MODEL=

# --- Optional: macro (still stubbed) ---
# FRED — bond yields / fed funds rate: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
