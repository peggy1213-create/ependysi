# Copy to backend/.env and fill in. Never commit the real .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# --- Optional API keys ---
# The watchlist and all market data (TWSE/TPEx open data, Yahoo Finance) need NO key.
# These are only for the still-stubbed /api/macro routes.

# FRED — macro series (bond yields, fed funds rate): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional alternative macro/quote providers (not currently wired)
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
